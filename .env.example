# COROS
COROS_EMAIL=
COROS_PASSWORD=
COROS_API_URL=https://api.coros.com

# Strava — get credentials at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# Garmin Connect
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Whoop (optional)
# Create a developer app at https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# TrainingPeaks (optional)
# Requires trainingpeaks-mcp installed and authed: https://github.com/your-org/trainingpeaks-mcp
# Run `tp-mcp auth` once to store your session cookie, then set the path below.
# TP_MCP_PATH=~/Developer/trainingpeaks-mcp
